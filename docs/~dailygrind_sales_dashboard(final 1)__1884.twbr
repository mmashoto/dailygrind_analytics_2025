              <calculation class='tableau' formula='// Total sales for the selected year and month&#13;&#10;&#13;&#10;IF [Calculation_832603002875412499] = [Parameters].[Parameter 1] &#13;&#10;AND &#13;&#10;[Calculation_832603002901245975] = [Parameters].[Parameter 3]&#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='MoM AOV Change' datatype='real' default-format='p0.0000%' name='[Calculation_832603002914025501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([CM Sales (copy)_832603002922270755] - LOOKUP([CM Sales (copy)_832603002922270755], -1) / (LOOKUP([CM Sales (copy)_832603002922270755], -1)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_832603002920828962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales])/ COUNT([datetimes])' />
            </column>
            <column caption='CM Transactions' datatype='integer' name='[Calculation_832603002927087655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3] &#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
            </column>
            <column caption='MoM Sales Change ' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%;' name='[MoM % Change (copy)_832603002925445157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_832603002905485337])-SUM([CM Sales (copy)_832603002913419292]))/(SUM([CM Sales (copy)_832603002913419292]))' />
            </column>
            <column caption='Transactions' datatype='integer' default-format='n#,##0;-#,##0' name='[PM Transations (copy)_832603002928128041]' role='measure' type='quantitative'>
