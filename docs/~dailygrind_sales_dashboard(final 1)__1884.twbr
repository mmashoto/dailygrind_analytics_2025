    <worksheet name='Sales Revenue'>
      <table>
        <view>
          <datasources>
            <datasource caption='Coffee Sales DataSource' name='federated.0wnfrk604a3eu617rswz10jre75k' />
          </datasources>
          <datasource-dependencies datasource='federated.0wnfrk604a3eu617rswz10jre75k'>
            <column caption='MoM % Change ' datatype='real' default-format='p0.00%' name='[Calculation_601230574253723649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sales])- LOOKUP(SUM([sales]),-1))/ LOOKUP(SUM([sales]),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM % Change Label' datatype='string' name='[Calculation_601230574255763458]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_601230574253723649]) THEN &apos;&apos;&#13;&#10;ELSE  &#13;&#10;    (IF [Calculation_601230574253723649] &gt; 0 THEN &apos;▲&apos; + STR(ROUND([Calculation_601230574253723649]*100, 1))+ &apos;%&apos;&#13;&#10;    ELSEIF  [Calculation_601230574253723649] &lt; 0 THEN &apos;▼&apos; + STR(ROUND(ABS([Calculation_601230574253723649])*100,1)) +&apos;%&apos;&#13;&#10;    ELSE &apos;0%&apos;&#13;&#10;    END)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI Sales Avg ' datatype='string' name='[KPI Sales Avg (copy)_601230574250926080]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([sales]) &gt; WINDOW_AVG(SUM([sales]))&#13;&#10;THEN &quot;above&quot;&#13;&#10;ELSE &quot;below&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM (R)  Change Label ' datatype='string' name='[MoM % Change Label (copy)_601230574256386051]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Executive MoM Sales Label (Amount in Thousands)&#13;&#10;&#13;&#10;IF ISNULL(SUM([sales]) - LOOKUP(SUM([sales]), -1)) THEN &quot;&quot;&#13;&#10;ELSE&#13;&#10;    IF SUM([sales]) - LOOKUP(SUM([sales]), -1) &gt; 0 THEN&#13;&#10;        &quot;▲ +R&quot; + STR(ROUND((SUM([sales]) - LOOKUP(SUM([sales]), -1))/1000, 1)) + &quot;K&quot;&#13;&#10;    ELSEIF SUM([sales]) - LOOKUP(SUM([sales]), -1) &lt; 0 THEN&#13;&#10;        &quot;▼ -R&quot; + STR(ROUND(ABS(SUM([sales]) - LOOKUP(SUM([sales]), -1))/1000, 1)) + &quot;K&quot;&#13;&#10;    ELSE&#13;&#10;        &quot;R0&quot;&#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Coffee Name' datatype='string' name='[coffee_name]' role='dimension' type='nominal' />
            <column caption='Datetimes' datatype='datetime' name='[datetimes]' role='dimension' type='ordinal' />
            <column-instance column='[datetimes]' derivation='Max' name='[max:datetimes:qk]' pivot='key' type='quantitative' />
