              <calculation class='tableau' formula='// Total sales for the selected year and month&#13;&#10;&#13;&#10;IF [Calculation_832603002875412499] = [Parameters].[Parameter 1] &#13;&#10;AND &#13;&#10;[Calculation_832603002901245975] = [Parameters].[Parameter 3]&#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='MoM AOV Change' datatype='real' default-format='p0.0000%' name='[Calculation_832603002914025501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([CM Sales (copy)_832603002922270755] - LOOKUP([CM Sales (copy)_832603002922270755], -1) / (LOOKUP([CM Sales (copy)_832603002922270755], -1)))'>
