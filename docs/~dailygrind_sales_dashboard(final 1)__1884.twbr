      <aliases enabled='yes' />
      <column caption='CY AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CM AOV (copy)_235031627469778945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total AOV for the selected year&#13;&#10;&#13;&#10;SUM(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [sales] END)&#13;&#10;/&#13;&#10;COUNT(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='PM AOV ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CM AOV (copy)_832603002924900388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total AOV for the selected year and month&#13;&#10;&#13;&#10;SUM(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3] -1&#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [sales] END)&#13;&#10;/&#13;&#10;COUNT(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3]-1&#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='PM Sales' datatype='real' default-format='n&quot;R&quot;#,##0,.00K;-&quot;R&quot;#,##0,.00K' name='[CM Sales (copy)_832603002913419292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total sales for the selected year and  previous month&#13;&#10;&#13;&#10;IF [Calculation_832603002875412499] = [Parameters].[Parameter 1] &#13;&#10;AND &#13;&#10;[Calculation_832603002901245975] = [Parameters].[Parameter 3] -1&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
      <column caption='CM AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CM Sales (copy)_832603002922270755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total AOV for the selected year and month&#13;&#10;&#13;&#10;SUM(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3] &#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [sales] END)&#13;&#10;/&#13;&#10;COUNT(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3] &#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='CY Transactions' datatype='integer' name='[CM Transations (copy)_235031627473018886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='PM Transactions' datatype='integer' name='[CM Transations (copy)_832603002927546408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_832603002901245975]= [Parameters].[Parameter 3]-1&#13;&#10;AND [Calculation_832603002875412499]= [Parameters].[Parameter 1]&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='PY AOV ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CY AOV (copy)_235031627470573572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total AOV for the selected year&#13;&#10;&#13;&#10;SUM(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1] -1&#13;&#10;THEN [sales] END)&#13;&#10;/&#13;&#10;COUNT(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1] -1&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column caption='PY Transactions' datatype='integer' name='[CY Transations (copy)_235031627473256455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_832603002875412499]= [Parameters].[Parameter 1]-1&#13;&#10;THEN [datetimes] END)' />
      </column>
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([MoM % Change (copy)_832603002925445157])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Sales Revenue Avg.' datatype='string' name='[Calculation_233061301788258312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([sales]) &gt; WINDOW_AVG(SUM([sales]))&#13;&#10;THEN &apos;Above&apos;&#13;&#10;ELSE &apos;Below&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter Calculation' datatype='boolean' name='[Calculation_358599138959036417]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([sales])) &lt;= [Parameters].[Parameter 4]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Change ' datatype='real' default-format='p0.00%' name='[Calculation_601230574253723649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sales])- LOOKUP(SUM([sales]),-1))/ LOOKUP(SUM([sales]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Change Label' datatype='string' name='[Calculation_601230574255763458]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_601230574253723649]) THEN &apos;&apos;&#13;&#10;ELSE  &#13;&#10;    (IF [Calculation_601230574253723649] &gt; 0 THEN &apos;▲&apos; + STR(ROUND([Calculation_601230574253723649]*100, 1))+ &apos;%&apos;&#13;&#10;    ELSEIF  [Calculation_601230574253723649] &lt; 0 THEN &apos;▼&apos; + STR(ROUND(ABS([Calculation_601230574253723649])*100,1)) +&apos;%&apos;&#13;&#10;    ELSE &apos;0%&apos;&#13;&#10;    END)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cf_Sales' datatype='real' default-format='n&quot;R&quot;#,##0,K;-&quot;R&quot;#,##0,K' name='[Calculation_832603002488246277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([sales]),0)' />
      </column>
      <column caption='cf_Time Axis' datatype='datetime' name='[Calculation_832603002490732550]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [datetimes])&#13;&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [datetimes])&#13;&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;, [datetimes])&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='cf_Time ' datatype='integer' name='[Calculation_832603002519158791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(0)' />
      </column>
      <column caption='cf_Sales vs Avg' datatype='string' name='[Calculation_832603002524377096]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  SUM([sales]) &gt;= WINDOW_AVG(SUM([sales]))&#13;&#10;THEN&#13;&#10; &apos;Above&apos;&#13;&#10;ELSE &#13;&#10;&apos;Below&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_832603002543497226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Year(Datetimes)' datatype='integer' name='[Calculation_832603002875412499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([datetimes])' />
      </column>
      <column caption='CY Sales' datatype='real' default-format='n&quot;R&quot;#,##0,K;-&quot;R&quot;#,##0,K' name='[Calculation_832603002877792276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_832603002875412499] = [Parameters].[Parameter 1]&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
      <column caption='PY Sales' datatype='real' default-format='n&quot;R&quot;#,##0,K;-&quot;R&quot;#,##0,K' name='[Calculation_832603002893647893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_832603002875412499] = [Parameters].[Parameter 1] -1 &#13;&#10;THEN [sales]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='YoY Sales Change' datatype='real' default-format='p0.00%' name='[Calculation_832603002900156438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_832603002877792276]) - SUM([Calculation_832603002893647893])) / (SUM([Calculation_832603002893647893]))' />
      </column>
      <column caption='Month(Datetime)' datatype='integer' name='[Calculation_832603002901245975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [datetimes])' />
      </column>
      <column caption='CM Sales' datatype='real' default-format='n&quot;R&quot;#,##0,.00K;-&quot;R&quot;#,##0,.00K' name='[Calculation_832603002905485337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total sales for the selected year and month&#13;&#10;&#13;&#10;IF [Calculation_832603002875412499] = [Parameters].[Parameter 1] &#13;&#10;AND &#13;&#10;[Calculation_832603002901245975] = [Parameters].[Parameter 3]&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
