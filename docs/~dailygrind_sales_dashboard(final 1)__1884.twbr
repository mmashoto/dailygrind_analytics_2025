    <worksheet name='Time Granularity.chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#cfa075'>&lt;[Parameters].[Parameter 5]&gt;</run>
            <run fontcolor='#adadad'> Sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Coffee Sales DataSource' name='federated.0wnfrk604a3eu617rswz10jre75k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.Time_Granularity' datatype='string' folder-name='p.Time_Granularity Switches' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wnfrk604a3eu617rswz10jre75k'>
            <column caption='cf_Sales' datatype='real' default-format='n&quot;R&quot;#,##0,K;-&quot;R&quot;#,##0,K' name='[Calculation_832603002488246277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([sales]),0)' />
            </column>
            <column caption='cf_Time Axis' datatype='datetime' name='[Calculation_832603002490732550]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [datetimes])&#13;&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [datetimes])&#13;&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;, [datetimes])&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='cf_Sales vs Avg' datatype='string' name='[Calculation_832603002524377096]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  SUM([sales]) &gt;= WINDOW_AVG(SUM([sales]))&#13;&#10;THEN&#13;&#10; &apos;Above&apos;&#13;&#10;ELSE &#13;&#10;&apos;Below&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Performance' datatype='string' name='[cf_Sales vs Avg (copy)_832603002531086345]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  SUM([sales]) &gt;= WINDOW_AVG(SUM([sales]))&#13;&#10;THEN&#13;&#10; &apos;Above Avg | R&apos; + STR(ROUND(SUM([sales])/1000,0))+ &apos;K&apos;&#13;&#10;ELSE &#13;&#10; &apos;Below Avg | R&apos; + STR(ROUND(SUM([sales])/1000,0))+ &apos;K&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Coffee Name' datatype='string' name='[coffee_name]' role='dimension' type='nominal' />
            <column caption='Datetimes' datatype='datetime' name='[datetimes]' role='dimension' type='ordinal' />
            <column-instance column='[datetimes]' derivation='Day' name='[dy:datetimes:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_832603002490732550]' derivation='None' name='[none:Calculation_832603002490732550:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_832603002490732550]' derivation='None' name='[none:Calculation_832603002490732550:qk]' pivot='key' type='quantitative' />
            <column-instance column='[coffee_name]' derivation='None' name='[none:coffee_name:nk]' pivot='key' type='nominal' />
            <column caption='Sales' datatype='real' default-format='n&quot;R&quot;#,##0,K;-&quot;R&quot;#,##0,K' name='[sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_832603002488246277]' derivation='User' name='[usr:Calculation_832603002488246277:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_832603002524377096]' derivation='User' name='[usr:Calculation_832603002524377096:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[cf_Sales vs Avg (copy)_832603002531086345]' derivation='User' name='[usr:cf_Sales vs Avg (copy)_832603002531086345:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0wnfrk604a3eu617rswz10jre75k].[Action (DAY(Datetimes))]'>
            <groupfilter function='level-members' level='[dy:datetimes:ok]' user:ui-action-filter='[Action2_5EDCE53376AA4070AEF8CD04BFAE6808]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0wnfrk604a3eu617rswz10jre75k].[none:Calculation_832603002490732550:ok]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_832603002490732550:ok]' />
              <groupfilter function='member' level='[none:Calculation_832603002490732550:ok]' member='#2025-03-23 00:00:00#' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0wnfrk604a3eu617rswz10jre75k].[none:Calculation_832603002490732550:ok]</column>
