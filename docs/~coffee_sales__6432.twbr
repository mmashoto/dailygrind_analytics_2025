    <worksheet name='Hover_Staff'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>Hoverable Buttons: </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>Shape</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'> mark w/ messages in the </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>tooltip</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>UI Improvements</run>
            <run>Æ&#10;</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>- Simplify tooltip by </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>removing command buttons</run>
            <run>Æ&#10;</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>- Keep the message by</run>
            <run fontcolor='#0d251a' fontname='Tableau Medium' fontsize='16'>Æ </run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>switching to the</run>
            <run fontcolor='#0d251a' fontname='Tableau Medium' fontsize='16'>Æ </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>On Hover setting</run>
            <run>Æ&#10;</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>- Remove black outline and expand interactable area w/ </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>transparent circle overlay</run>
            <run>Æ&#10;</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'>- Deactive white-out highlight w/ </run>
            <run fontcolor='#0d251a' fontname='Tableau Semibold' fontsize='16'>False Highlight</run>
            <run fontcolor='#0d251a' fontname='Tableau Regular' fontsize='16'> setting</run>
