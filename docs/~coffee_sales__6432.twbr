    <worksheet name='On_Off_Chart 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium'>Monthly Orders by Product</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Medium' fontsize='10'>Category Grouping</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>How to:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a calculated field: IIF(p.On/Off_Grouping = &apos;On&apos;, [Category], [Category]+&apos;/&apos;+[Subcategory])</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Place the field in the </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Detail</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> card</run>
          </formatted-text>
