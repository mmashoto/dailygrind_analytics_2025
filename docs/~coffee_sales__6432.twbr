      <table>
        <view>
          <datasources>
            <datasource caption='index_1 (Coffee_sales_excel)' name='federated.0fft0yv03bvjil131ben719wug63' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
            <column caption='Select Month' datatype='date' datatype-customized='true' default-format='*MMM YYYY' name='[Select Year (copy)_367606369704382469]' param-domain-type='list' role='measure' type='quantitative' value='#2024-06-07#'>
              <calculation class='tableau' formula='#2024-06-07#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fft0yv03bvjil131ben719wug63'>
            <column caption='CY Sales' datatype='real' name='[Calculation_263742103866892290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([dates]) = [Parameters].[Parameter 4]&#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='PY Sales' datatype='real' name='[Calculation_263742103874134019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([dates]) = [Parameters].[Parameter 4] -1 &#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='distinct_dates' datatype='string' name='[Calculation_452611814058901504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [dates])+ &apos; &apos; + STR(YEAR([dates]))' />
            </column>
            <column caption='MoM' datatype='real' default-format='*0.00%;-0.0%;' name='[Calculation_657807071762841602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_657807071767314435])- SUM([Calculation_657807071771832324]))/ SUM([Calculation_657807071771832324])' />
            </column>
            <column caption='CM Sales' datatype='real' name='[Calculation_657807071767314435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;MONTH([dates]) = MONTH([Parameters].[Select Year (copy)_367606369704382469])&#13;&#10;AND &#13;&#10;YEAR([dates]) = [Parameters].[Parameter 4]&#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='PM Sales' datatype='real' name='[Calculation_657807071771832324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;   YEAR([dates]) = &#13;&#10;        IF  MONTH([Parameters].[Select Year (copy)_367606369704382469]) = 1 &#13;&#10;        THEN [Parameters].[Parameter 4] -1 &#13;&#10;        ELSE [Parameters].[Parameter 4]&#13;&#10;   END&#13;&#10;   AND MONTH([dates]) = &#13;&#10;        IF MONTH([Parameters].[Select Year (copy)_367606369704382469]) = 1&#13;&#10;        THEN 12&#13;&#10;        ELSE MONTH([Parameters].[Select Year (copy)_367606369704382469]) - 1&#13;&#10;    END&#13;&#10;THEN [sales]&#13;&#10;END' />
            </column>
            <column caption='Dates' datatype='date' name='[dates]' role='dimension' type='ordinal' />
            <column-instance column='[dates]' derivation='Month' name='[mn:dates:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_452611814058901504]' derivation='None' name='[none:Calculation_452611814058901504:nk]' pivot='key' type='nominal' />
            <column caption='Sales' datatype='real' name='[sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_263742103866892290]' derivation='Sum' name='[sum:Calculation_263742103866892290:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_263742103874134019]' derivation='Sum' name='[sum:Calculation_263742103874134019:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_657807071767314435]' derivation='Sum' name='[sum:Calculation_657807071767314435:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_657807071771832324]' derivation='Sum' name='[sum:Calculation_657807071771832324:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_657807071762841602]' derivation='User' name='[usr:Calculation_657807071762841602:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0fft0yv03bvjil131ben719wug63].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
