      <column caption='A/B_Axis Flip' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[A/B_Y-axis (copy)_752030775670833218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &apos;Profit per Order&apos;&#10;, &apos;Sales per Order&apos;&#10;, &apos;Profit per Order&apos;)' />
      </column>
      <column caption='Days to Ship Actual' datatype='integer' name='[Calculation_0831103151444568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='.Apple' datatype='string' name='[Calculation_464996666622640130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Apple&quot;' />
      </column>
      <column caption='.Orange' datatype='string' name='[Calculation_464996666622685187]' role='dimension' type='nominal'>
