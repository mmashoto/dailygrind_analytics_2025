    <worksheet name='On_Off_Chart 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium'>MTD Sales by Category ($)</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Medium' fontsize='10'>Month-End Targets</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>How to:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a calculated field: IIF(p.On/Off_Target = &apos;Show&apos;, SUM([Target for Dec 2023]), NULL)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Place the field in the </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Column</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Æ </run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>dual axis</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> for the field and the [Sales_Demo] field</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.10nnk8d1vgmw8q17yu76u06pnbcj' />
            <datasource caption='Sales Target' name='federated.0hgpf0j1fdpvv316shikk0mmdlec' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.On_Off_Target Values' datatype='string' folder-name='p.On/Off Switches' name='[p.On/Off_Full Scale (copy)_752030775627034656]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show&quot;'>
              <calculation class='tableau' formula='&quot;Show&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hgpf0j1fdpvv316shikk0mmdlec'>
            <column caption='Target for Dec 2023' datatype='integer' name='[Calculation_752030775622885397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(DATETRUNC(&apos;month&apos;,[Order Date]) = #2023-12-01#&#10;, [Sales Target]&#10;, NULL)' />
            </column>
            <column caption='On/Off_Target' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[On/Off_Group (copy)_752030775647281198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[p.On/Off_Full Scale (copy)_752030775627034656] = &apos;Show&apos;&#10;, SUM([Calculation_752030775622885397])&#10;, NULL)' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Sales Target]' role='measure' type='quantitative' />
            <column-instance column='[On/Off_Group (copy)_752030775647281198]' derivation='User' name='[usr:On/Off_Group (copy)_752030775647281198:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10nnk8d1vgmw8q17yu76u06pnbcj'>
            <column caption='Sales_Demo' datatype='real' name='[Calculation_752030775623180310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Order Date] &gt;= #2023-12-01#&#10;    AND [Order Date] &lt;= #2023-12-14#&#10;, [Sales]&#10;, NULL)' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='date' default-format='*m/d/yy' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_752030775623180310]' derivation='Sum' name='[sum:Calculation_752030775623180310:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.10nnk8d1vgmw8q17yu76u06pnbcj].[none:Category:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Furniture&quot;</bucket>
              <bucket>&quot;Office Supplies&quot;</bucket>
              <bucket>&quot;Technology&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
