      </column>
      <column caption='CY Sales' datatype='real' name='[Calculation_263742103866892290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([dates]) = [Parameters].[Parameter 4]&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
      <column caption='PY Sales' datatype='real' name='[Calculation_263742103874134019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([dates]) = [Parameters].[Parameter 4] -1 &#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
      <column caption='distinct_dates' datatype='string' name='[Calculation_452611814058901504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [dates])+ &apos; &apos; + STR(YEAR([dates]))' />
      </column>
      <column caption='Month(Order Year)' datatype='integer' name='[Calculation_657807071760945152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MONTH([dates])' />
      </column>
      <column caption='MoM' datatype='real' default-format='*0.00%;-0.0%;' name='[Calculation_657807071762841602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_657807071767314435])- SUM([Calculation_657807071771832324]))/ SUM([Calculation_657807071771832324])' />
      </column>
      <column caption='CM Sales' datatype='real' name='[Calculation_657807071767314435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;MONTH([dates]) = MONTH([Parameters].[Select Year (copy)_367606369704382469])&#13;&#10;AND &#13;&#10;YEAR([dates]) = [Parameters].[Parameter 4]&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
      <column caption='PM Sales' datatype='real' name='[Calculation_657807071771832324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;   YEAR([dates]) = &#13;&#10;        IF  MONTH([Parameters].[Select Year (copy)_367606369704382469]) = 1 &#13;&#10;        THEN [Parameters].[Parameter 4] -1 &#13;&#10;        ELSE [Parameters].[Parameter 4]&#13;&#10;   END&#13;&#10;   AND MONTH([dates]) = &#13;&#10;        IF MONTH([Parameters].[Select Year (copy)_367606369704382469]) = 1&#13;&#10;        THEN 12&#13;&#10;        ELSE MONTH([Parameters].[Select Year (copy)_367606369704382469]) - 1&#13;&#10;    END&#13;&#10;THEN [sales]&#13;&#10;END' />
      </column>
