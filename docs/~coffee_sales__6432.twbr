    <worksheet name='Proto-Button Step 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Proto-Button: Starting Point for All Button Types</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Tooltip Settings for Better UI:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Show tooltips </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>On Hover </run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Exclude</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> command buttons </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Before Use:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Replaced</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> the purple circle w/ </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>a transparent circle</run>
            <run fontcolor='#112c5d' fontname='Tableau Semibold' fontsize='14'>Æ </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='12' italic='true'>(circle PNG file w/ 0% opacity) </run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Remove</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> the zero lines</run>
          </formatted-text>
        </caption>
      </layout-options>
