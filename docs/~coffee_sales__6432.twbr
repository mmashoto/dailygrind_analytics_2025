      <column caption='On/Off Flip' datatype='string' name='[A/B Toggle Flip (copy)_752030774602743822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[p.A/B Toggle (copy)_752030774602625037] = &apos;On&apos;,&apos;Off&apos;,&apos;On&apos;)' />
      </column>
      <column caption='On/Off_Grouping' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[A/B_Color (copy)_752030775646449709]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[p.On/Off_Target (copy)_752030775627665441] = &apos;Yes&apos;&#10;, [Category]&#10;, [Category]+&apos;/&apos;+[Sub-Category])' />
      </column>
      <column caption='A/B_Color Flip' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[A/B_Color (copy)_752030775671332931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[p.A/B_Y-axis (copy)_752030775626342429] = &apos;Category&apos;&#10;, &apos;Segment&apos;&#10;, &apos;Category&apos;)' />
      </column>
      <column caption='A/B_Color' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[A/B_Y-axis (copy)_752030775638986793]' role='dimension' type='nominal'>
