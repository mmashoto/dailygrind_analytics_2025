    <worksheet name='On_Off_Chart 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium'>Monthly Punctual Delivery Rates</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Medium' fontsize='10'>Full Scale</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>How to:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a calculated field: IIF(p.On/Off_Full Scale = &apos;Yes&apos;, 0, NULL)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a calculated field: IIF(p.On/Off_Full Scale = &apos;Yes&apos;, 1, NULL)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Place both fields in the </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Detail </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>card, aggregate them by their </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>MIN </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>values</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create two </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>transparent reference lines </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>for the y-axis using both fields above</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Exclude zero from the y-axis</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Duplicate the y-axis field and modify it ad-hoc: IIF(p.On/Off_Full Scale = &apos;Yes&apos;, [%Order], NULL)</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.10nnk8d1vgmw8q17yu76u06pnbcj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.On/Off_Full Scale' datatype='string' folder-name='p.On/Off Switches' name='[p.On/Off Toggle (copy)_752030775626792990]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10nnk8d1vgmw8q17yu76u06pnbcj'>
            <column caption='%Order Punctual_Demo_On/Off' datatype='real' name='[%Order Punctual_Alert (copy)_752030775650455604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Order Date] &gt;= #2022-01-01#)&#10;THEN [Calculation_464996666632065032]*0.88&#10;ELSE [Calculation_464996666632065032]&#10;END' />
            </column>
            <column caption='Days to Ship Actual' datatype='integer' name='[Calculation_0831103151444568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
            </column>
            <column caption='%Order Punctual' datatype='real' name='[Calculation_464996666632065032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IIF([Calculation_6401103171259723] &lt;&gt; &quot;Shipped Late&quot;&#10;        , [Order ID]&#10;        , NULL)&#10;) &#10;/ &#10;COUNTD([Order ID])' />
            </column>
            <column caption='Ship Status' datatype='string' name='[Calculation_6401103171259723]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_0831103151444568]&gt; [Calculation_6861103170623145] then &quot;Shipped Late&quot; &#13;&#10;elseIF [Calculation_0831103151444568]= [Calculation_6861103170623145] then &quot;Shipped On Time&quot;&#13;&#10;Else &quot;Shipped Early&quot; end' />
              <desc>
                <formatted-text>
                  <run>Was shipment early, ontime or late based on ship mode</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Days to Ship Scheduled' datatype='integer' name='[Calculation_6861103170623145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Ship Mode]&#13;&#10;WHEN &quot;Same Day&quot; THEN 0&#13;&#10;WHEN &quot;First Class&quot; THEN 1&#13;&#10;WHEN &quot;Second Class&quot; THEN 3&#13;&#10;WHEN &quot;Standard Class&quot; THEN 6&#13;&#10;END' />
            </column>
            <column caption='IIF([p.On/Off_Full Scale] = &apos;Yes&apos;,[%Order Punctual_Demo_On/Of...' datatype='real' name='[Calculation_752030775650631733]' role='measure' type='quantitative' user:unnamed='Chart_On/Off_Scale'>
              <calculation class='tableau' formula='IIF([Parameters].[p.On/Off Toggle (copy)_752030775626792990] = &apos;Yes&apos;,[%Order Punctual_Alert (copy)_752030775650455604],NULL)' />
            </column>
            <column caption='On/Off_Full Scale_0' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[On/Off_Full Scale_100 (copy)_752030775649890355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[p.On/Off Toggle (copy)_752030775626792990] = &apos;Yes&apos;&#10;, 0&#10;, NULL)' />
            </column>
            <column caption='On/Off_Full Scale_100' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[On/Off_Grouping (copy)_752030775649693745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[p.On/Off Toggle (copy)_752030775626792990] = &apos;Yes&apos;&#10;, 1&#10;, NULL)' />
            </column>
            <column datatype='date' default-format='*m/d/yy' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='date' name='[Ship Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
            <column-instance column='[On/Off_Full Scale_100 (copy)_752030775649890355]' derivation='Min' name='[min:On/Off_Full Scale_100 (copy)_752030775649890355:qk]' pivot='key' type='quantitative' />
            <column-instance column='[On/Off_Grouping (copy)_752030775649693745]' derivation='Min' name='[min:On/Off_Grouping (copy)_752030775649693745:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Month-Trunc' name='[tmn:Order Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[%Order Punctual_Alert (copy)_752030775650455604]' derivation='User' name='[usr:%Order Punctual_Alert (copy)_752030775650455604:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_752030775650631733]' derivation='User' name='[usr:Calculation_752030775650631733:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
