    <worksheet name='A_B Switch'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontname='Tableau Regular'>Shape: Fixed</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular'>Text: </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold'>[A/B Flip] </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='12' italic='true'>= IIF([p.A/B] = &apos;A&apos;, &apos;B&apos;, &apos;A&apos;)</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular'>Tooltip: </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold'>[A/B Flip]</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular'>UI Tips:</run>
            <run>Æ&#10;</run>
            <run fontname='Verdana'>●</run>
            <run fontname='Tableau Regular'> [.Apple] and [.Orange] are used to </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold'>deactivate</run>
            <run fontname='Tableau Regular'> the clicking-induced highlights. (See dashboard Filter action.)</run>
            <run>Æ&#10;</run>
            <run fontname='Verdana'>●</run>
            <run fontname='Tableau Regular'> The x-axis range has been </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold'>manually adjusted</run>
            <run fontname='Tableau Regular'> to center the switch-text group.</run>
          </formatted-text>
        </caption>
