    <worksheet name='On_Off_Chart 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium'>Monthly Orders by Product</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Medium' fontsize='10'>Scales Syncing</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>How to:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a calculated field: IIF(p.On/Off_Sync Scales = &apos;Yes&apos;,  </run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>          MAX(</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>              {FIXED DATETRUNC(&apos;month&apos;,[Order Date]) ,[Sub-Category]:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>                  COUNT([Orders])</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>              }, NULL)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Place the fields in the </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>Detail </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>card</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Create a </run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'>transparent reference line </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>for all y-axes using the field</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>●</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> Select</run>
            <run fontcolor='#ab7bee' fontname='Tableau Semibold' fontsize='14'> Independent axis range for each row</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
