          <formatted-text>
            <run>Proto-Button: Starting Point for All Button Types</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Weakness</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#f8538a' fontname='Tableau Semibold' fontsize='14'>Ugly outline</run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'> &amp; </run>
            <run fontcolor='#f8538a' fontname='Tableau Semibold' fontsize='14'>unrelated command buttons </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>occur when you click the icon</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Button&apos;s hoverable area is </run>
            <run fontcolor='#f8538a' fontname='Tableau Semibold' fontsize='14'>small &amp; limiting </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>to the icon shape</run>
            <run>Æ&#10;</run>
            <run fontcolor='#112c5d' fontname='Verdana' fontsize='14'>● </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>Tooltip text </run>
            <run fontcolor='#f8538a' fontname='Tableau Semibold' fontsize='14'>appears only </run>
            <run fontcolor='#112c5d' fontname='Tableau Regular' fontsize='14'>when you hover above the icon</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
