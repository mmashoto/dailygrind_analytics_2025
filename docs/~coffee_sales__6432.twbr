              <calculation class='tableau' formula='IIF([Parameters].[p.On/Off Toggle (copy) (copy)_752030775626801183] = &apos;Yes&apos;&#10;, MAX(&#10;    {FIXED DATETRUNC(&apos;month&apos;,[Order Date])&#10;    ,[Sub-Category]:&#10;        COUNT([__tableau_internal_object_id__].[Orders_6D2EF74F348B46BDA976A7AEEA6FB5C9])&#10;    }&#10;)&#10;, NULL)' />
